FRONTEND_HOST_PORT=3000

# Local split-origin Docker run: browser opens Nuxt on :3000 and calls FastAPI on :8000.
# For same-origin production behind Nginx/Caddy, keep this value empty and proxy API paths.
NUXT_API_BASE_URL=http://host.docker.internal:8000
NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NUXT_PUBLIC_API_TIMEOUT=10000

NUXT_PUBLIC_ADMIN_OPS_ENABLED=false
NUXT_PUBLIC_CODEX_FEATURE_ENABLED=true
NUXT_PUBLIC_CODEX_REALTIME_PATH=/codex/events
NUXT_PUBLIC_CODEX_WS_BASE_URL=ws://127.0.0.1:8000

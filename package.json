{
  "name": "typescript-web-nuxt",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm build:ssr",
    "build:ssr": "nuxt build",
    "dev": "nuxt dev",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test -- --run && pnpm test:coverage && pnpm build && pnpm test:e2e",
    "release:check": "pnpm verify",
    "test": "vitest",
    "test:coverage": "vitest --coverage --run",
    "test:watch": "vitest --watch",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@lucide/vue": "^1.17.0",
    "@pinia/nuxt": "^0.11.3",
    "@speed-highlight/core": "1.2.15",
    "@tanstack/vue-virtual": "^3.13.35",
    "markdown-it": "^15.0.0",
    "nuxt": "^4.4.6",
    "pinia": "^3.0.4",
    "qrcode.vue": "^3.10.0",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "packageManager": "pnpm@10.11.1+sha512.e519b9f7639869dc8d5c3c5dfef73b3f091094b0a006d7317353c72b124e80e1afd429732e28705ad6bfa1ee879c1fce46c128ccebd3192101f43dd67c667912",
  "devDependencies": {
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/hints": "1.1.2",
    "@nuxt/test-utils": "4.0.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.4.1",
    "happy-dom": "^20.9.0",
    "playwright-core": "^1.60.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  }
}
